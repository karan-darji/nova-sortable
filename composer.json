{
  "name": "outl1ne/nova-sortable",
  "description": "This Laravel Nova package allows you to reorder models in a Nova resource's index view using drag & drop.",
  "keywords": [
    "laravel",
    "nova",
    "eloquent-sortable",
    "optimistdigital",
    "outl1ne"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "spatie/eloquent-sortable": "^5.0",
    "laravel/nova": "^4.0 | ^5.0",
    "outl1ne/nova-translations-loader": "dev-nova-v5"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    },
    {
      "type": "vcs",
      "url": "https://github.com/karan-darji/nova-translations-loader"
    }
  ],
  "autoload": {
    "psr-4": {
      "Outl1ne\\NovaSortable\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Outl1ne\\NovaSortable\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
