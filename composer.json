{
  "name": "outl1ne/nova-sortable",
  "description": "This Laravel Nova package allows you to reorder models in a Nova resource's index view using drag & drop.",
  "keywords": [
    "laravel",
    "nova",
    "eloquent-sortable",
    "optimistdigital",
    "outl1ne"
  ],
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "spatie/eloquent-sortable": "^4.4",
    "laravel/nova": "^4.0|^5.0",
    "outl1ne/nova-translations-loader": "dev-feature/php-8plus-laravel-8plus-nova-4plus"
  },
  "require-dev": {
    "laravel/nova-devtool": "^1.8.1"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    },
    {
      "type": "vcs",
      "url": "https://github.com/karan-darji/nova-translations-loader"
    }
  ],
  "autoload": {
    "psr-4": {
      "Outl1ne\\NovaSortable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "workbench/app/",
      "Database\\Factories\\": "workbench/database/factories/",
      "Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Outl1ne\\NovaSortable\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ]
  }
}
